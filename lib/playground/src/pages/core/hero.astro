<style>
  .container {
    position: relative;
    width: min(80%, 700px);
  }

  canvas {
    width: 100%;
    border: none;
  }

  .pointer-zone {
    position: absolute;
    inset: -20%;
  }

  svg {
    position: absolute;
    pointer-events: none;
    width: 30%;
    width: 60%;
    height: auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  svg :not(#bg) {
    pointer-events: none;
  }
</style>
