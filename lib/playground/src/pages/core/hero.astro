---
import Layout from "../../layouts/Layout.astro";
---

<script>
  import { bloom, glCanvas, linearToneMapping, loop, onPointerEvents } from "@radiancejs/gl";
  import { fragment } from "../../shaders/hero";

  const { canvas, uniforms } = glCanvas({
    canvas: "#glCanvas",
    fragment,
    uniforms: {
      uHappyCursor: 0,
      iTime: 0,
    },
    colorSpace: "display-p3",
    postEffects: [bloom(), linearToneMapping({ exposure: 1.2 })],
  });

  const eyesLaughAnimations = document.querySelectorAll<SVGAnimateElement>(".eyes .laugh");
  const eyesHappyAnimations = document.querySelectorAll<SVGAnimateElement>(".eyes .happy");
  const mouseLaughAnimations = document.querySelectorAll<SVGAnimateElement>(".mouse .laugh");
  const mouseHappyAnimations = document.querySelectorAll<SVGAnimateElement>(".mouse .happy");
  const pointerZone = document.querySelector<HTMLElement>("#pointerZone")!;
  const faceGroup = document.querySelector<SVGGElement>("#face")!;
  const eyesGroup = document.querySelector<SVGGElement>("#eyesGroup")!;
  const mouthGroup = document.querySelector<SVGGElement>("#mouthGroup")!;
  const leftEyeHighlight = document.querySelector<SVGGElement>("#leftEyeHighlight")!;
  const rightEyeHighlight = document.querySelector<SVGGElement>("#rightEyeHighlight")!;

  const clamp = (n: number, min: number, max: number) => Math.min(Math.max(n, min), max);
  const lerp = (from: number, to: number, t: number) => from + (to - from) * t;

  let targetHappyCursor = 0;
  let eyesState: "happy" | "laugh" = "happy";
  let mouseState: "happy" | "laugh" = "happy";
  let pointerOffset = { x: 0, y: 0 };
  let targetFaceOffset = { x: 0, y: 0 };
  let faceOffset = { x: 0, y: 0 };
  let eyesOffset = { x: 0, y: 0 };
  let mouthOffset = { x: 0, y: 0 };
  let highlightOffset = { x: 0, y: 0 };

  const eyesLaugh = () => {
    eyesLaughAnimations.forEach((el) => el.beginElement());
    eyesState = "laugh";
  };
  const eyesHappy = () => {
    eyesHappyAnimations.forEach((el) => el.beginElement());
    eyesState = "happy";
  };
  const mouseLaugh = () => {
    mouseLaughAnimations.forEach((el) => el.beginElement());
    mouseState = "laugh";
  };
  const mouseHappy = () => {
    mouseHappyAnimations.forEach((el) => el.beginElement());
    mouseState = "happy";
  };

  const blink = () => {
    if (eyesState === "happy") {
      eyesLaugh();
      setTimeout(() => {
        if (eyesState === "laugh") {
          eyesHappy();
        }
      }, 100);
    }
  };

  setTimeout(() => {
    blink();
    setInterval(blink, 5000);
  }, 1500);

  onPointerEvents(pointerZone, {
    move: ({ pointer, boundingRect }) => {
      const pointerDirection = {
        x: pointer.x - boundingRect.center.x,
        y: pointer.y - boundingRect.center.y,
      };
      const normalizedPointer = {
        x: clamp(pointerDirection.x / (boundingRect.width * 0.5), -1, 1),
        y: clamp(pointerDirection.y / (boundingRect.height * 0.5), -1, 1),
      };

      pointerOffset = normalizedPointer;
      targetFaceOffset = {
        x: 0 + normalizedPointer.x * 8,
        y: 0 + normalizedPointer.y * 6,
      };

      const distToCenter = Math.sqrt(pointerDirection.x ** 2 + pointerDirection.y ** 2);
      const relativeDistance = distToCenter / ((canvas as HTMLCanvasElement).clientWidth / 2);
      targetHappyCursor = Math.sqrt(clamp(1.2 - relativeDistance, 0, 1));

      if (relativeDistance < 0.5 && eyesState === "happy") {
        eyesLaugh();
      } else if (relativeDistance >= 0.5 && eyesState === "laugh") {
        eyesHappy();
      }

      if (relativeDistance < 1 && mouseState === "happy") {
        mouseLaugh();
      } else if (relativeDistance >= 1 && mouseState === "laugh") {
        mouseHappy();
      }
    },
    leave: () => {
      pointerOffset = { x: 0, y: 0 };
      targetFaceOffset = { x: 0, y: 0 };
      targetHappyCursor = 0;
      if (eyesState === "laugh") {
        eyesHappy();
      }
      if (mouseState === "laugh") {
        mouseHappy();
      }
    },
  });

  loop(({ deltaTime }) => {
    const smoothing = clamp(1 - Math.exp(-deltaTime / 120), 0, 1);
    const followSmoothing = clamp(1 - Math.exp(-deltaTime / 90), 0, 1);

    faceOffset.x = lerp(faceOffset.x, targetFaceOffset.x, smoothing);
    faceOffset.y = lerp(faceOffset.y, targetFaceOffset.y, smoothing);

    eyesOffset.x = lerp(eyesOffset.x, pointerOffset.x * 6, followSmoothing);
    eyesOffset.y = lerp(eyesOffset.y, pointerOffset.y * 3.5, followSmoothing);

    mouthOffset.x = lerp(mouthOffset.x, pointerOffset.x * 3.5, smoothing * 0.8);
    mouthOffset.y = lerp(mouthOffset.y, pointerOffset.y * 2.0, smoothing * 0.8);

    highlightOffset.x = lerp(
      highlightOffset.x,
      pointerOffset.x * 4,
      clamp(followSmoothing * 1.2, 0, 1),
    );
    highlightOffset.y = lerp(
      highlightOffset.y,
      pointerOffset.y * 2.5,
      clamp(followSmoothing * 1.2, 0, 1),
    );

    faceGroup.setAttribute("transform", `translate(${faceOffset.x}, ${faceOffset.y})`);
    eyesGroup.setAttribute("transform", `translate(${eyesOffset.x}, ${eyesOffset.y})`);
    mouthGroup.setAttribute("transform", `translate(${mouthOffset.x}, ${mouthOffset.y})`);
    leftEyeHighlight.setAttribute(
      "transform",
      `translate(${highlightOffset.x}, ${highlightOffset.y})`,
    );
    rightEyeHighlight.setAttribute(
      "transform",
      `translate(${highlightOffset.x}, ${highlightOffset.y})`,
    );

    if (Math.abs(targetHappyCursor - uniforms.uHappyCursor) > 0.01) {
      uniforms.uHappyCursor += ((targetHappyCursor - uniforms.uHappyCursor) * deltaTime) / 100;
    }
    uniforms.iTime += (deltaTime * (0.4 + uniforms.uHappyCursor * 1.6)) / 500;
  });
</script>

