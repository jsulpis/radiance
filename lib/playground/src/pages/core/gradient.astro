---
import GlobalPlayPause from "../../components/GlobalPlayPause.astro";
import Layout from "../../layouts/Layout.astro";
---

<script>
  import { glCanvas } from "@radiancejs/gl";
  import { incrementRenderCount } from "../../components/renderCount";

  const { onAfterRender } = glCanvas({
    canvas: document.querySelector("canvas")!,
    fragment: /* glsl */ `
			varying vec2 vUv;
			uniform float uTime;

			void main() {
				gl_FragColor = vec4(vUv, sin(uTime) / 2. + .5, 1.);
			}
		`,
    uniforms: {
      uTime: ({ time }) => time / 500,
    },
    immediate: false,
  });

  onAfterRender(incrementRenderCount);
</script>

<Layout title="Gradient">
  <GlobalPlayPause />
  <canvas></canvas>
</Layout>
