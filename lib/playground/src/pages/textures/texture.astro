---
import Layout from "../../layouts/Layout.astro";
---

<script>
  import { glCanvas, loadTexture } from "@radiancejs/gl";
  import { incrementRenderCount } from "../../components/renderCount";
  import type { TextureParams } from "@radiancejs/gl";

  const { onAfterRender, uniforms } = glCanvas({
    canvas: "#glCanvas",
    fragment: /* glsl */ `
      in vec2 vUv;
      uniform sampler2D uTexture;
      uniform vec2 uResolution;
      out vec4 fragColor;

      #define CONTAIN 1
      #define COVER 2
      #define OBJECT_FIT CONTAIN

      void main() {
        vec2 textureResolution = vec2(textureSize(uTexture, 0));
        float canvasRatio = uResolution.x / uResolution.y;
        float textureRatio = textureResolution.x / textureResolution.y;

        vec2 uv = vUv - 0.5;
        if (OBJECT_FIT == CONTAIN ? canvasRatio > textureRatio : canvasRatio < textureRatio) {
          uv.x *= canvasRatio / textureRatio;
        } else {
          uv.y *= textureRatio / canvasRatio;
        }
        uv += 0.5;

        vec3 color = texture(uTexture, uv).rgb;
        color *= step(0., uv.x) * (1. - step(1., uv.x));
        color *= step(0., uv.y) * (1. - step(1., uv.y));

        fragColor = vec4(color, 1.);
      }
    `,
    uniforms: {
      uTexture: {
        // 6x4 downscale of lotus.jpg, used as a placeholder until the full texture loads
        data: new Uint8Array(
          [
            [13, 24, 41, 255], [24, 43, 72, 255], [27, 55, 90, 255], [44, 70, 99, 255], [83, 109, 97, 255], [59, 79, 69, 255],
            [18, 28, 46, 255], [18, 43, 76, 255], [91, 109, 149, 255], [189, 115, 139, 255], [150, 112, 119, 255], [74, 99, 87, 255],
            [16, 26, 44, 255], [19, 43, 72, 255], [104, 106, 124, 255], [187, 82, 102, 255], [135, 75, 89, 255], [50, 62, 53, 255],
            [13, 24, 40, 255], [22, 40, 68, 255], [29, 39, 55, 255], [28, 22, 21, 255], [5, 8, 7, 255], [5, 12, 22, 255],
          ].flat(),
        ),
        width: 6,
        height: 4,
      } as TextureParams,
      uResolution: ({ canvasResolution }) => canvasResolution,
    },
  });

  // small delay to ensure that there are 2 renders for the screenshot test
  setTimeout(() => {
    loadTexture("/images/lotus.jpg").then((texture) => {
      uniforms.uTexture = texture;
    });
  }, 20);

  onAfterRender(incrementRenderCount);
</script>

<Layout title="Texture">
  <canvas id="glCanvas"></canvas>
</Layout>

<style>
  canvas {
    height: 350px;
  }
</style>
