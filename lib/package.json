{
  "name": "@radiancejs/gl",
  "version": "0.12.2",
  "description": "Lightweight, reactive WebGL library for working with shaders",
  "keywords": [
    "webgl",
    "webgl2",
    "shaders",
    "glsl",
    "3d",
    "graphics"
  ],
  "homepage": "https://radiancejs.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jsulpis/radiance.git",
    "directory": "lib"
  },
  "license": "MIT",
  "author": "Julien SULPIS",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm build:lib && pnpm docgen",
    "build:lib": "tsdown",
    "dev": "astro dev --port 3000",
    "docgen": "typedoc && node ./scripts/copy-docs.mjs && prettier --write ../docs/api --log-level warn --print-width 80",
    "format": "prettier src --check",
    "format:fix": "prettier src --write",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "prepack": "tsdown",
    "release": "changelogen --release --clean --push && npm publish",
    "test": "playwright test",
    "test:local": "docker compose run --build --rm -p 9323:9323 test",
    "test:update": "docker compose run --build --rm -p 9323:9323 test sh -c 'xvfb-run pnpm run test -u'",
    "typecheck": "tsc --noEmit && astro check --tsconfig playground/tsconfig.json"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "0.18.5",
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@tweakpane/core": "2.0.5",
    "@types/node": "24.13.6",
    "astro": "7.3.3",
    "changelogen": "0.6.2",
    "eslint": "10.11.0",
    "eslint-config-unjs": "0.6.2",
    "gl-matrix": "3.4.4",
    "prettier": "3.9.8",
    "publint": "0.3.24",
    "tsdown": "0.23.0",
    "tweakpane": "4.0.5",
    "typedoc": "0.28.20",
    "typedoc-plugin-markdown": "4.13.1",
    "typedoc-vitepress-theme": "1.1.4",
    "typescript": "6.0.3",
    "vite-plugin-glsl": "1.6.1"
  },
  "packageManager": "pnpm@12.5.0+sha512.9cdbaa34ffacae1768635ac0d23e94db6201c7d59bf3da236b23d67c8f6b794d1dab323bcd5bcc51b55c8cafbf6f19a24e4aa61d6ab7772aa3b5cc85e325dc4d",
  "changelog": {
    "excludeAuthors": [
      ""
    ]
  }
}
